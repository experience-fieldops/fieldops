<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/>
	</parent>
	<groupId>com.experiencefieldops</groupId>
	<artifactId>api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>api</name>
	<description>FieldOps API REST</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ── Rate Limiting (issue #77) ──────────────────────────────────────
		     Bucket4j: implementação do algoritmo Token Bucket para rate limiting.
		     Usada no LoginRateLimitFilter e no RateLimitFilter.
		     Versão fixada para evitar surpresas em build (sem ^ ou ~).
		-->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-core</artifactId>
			<version>8.10.1</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!--
				OWASP Dependency-Check (issue #80)
				────────────────────────────────────────────────────────────────────
				Escaneia as dependências do projeto em busca de CVEs conhecidos
				consultando o banco de dados NVD (National Vulnerability Database).

				Como usar:
				  mvn dependency-check:check

				O relatório é gerado em:
				  target/dependency-check-report.html

				Parâmetro failBuildOnCVSS:
				  Interrompe o build se alguma vulnerabilidade com score CVSS >= 7
				  (HIGH ou CRITICAL) for encontrada. Ajuste conforme a política da equipe.

				Atualização do banco NVD:
				  O plugin baixa/atualiza o banco NVD automaticamente na primeira execução.
				  Configure uma API Key NVD para evitar throttling em CI:
				    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
				  Obtenha em: https://nvd.nist.gov/developers/request-an-api-key
			-->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>10.0.3</version>
				<configuration>
					<!-- Interrompe o build em vulnerabilidades HIGH (7.0) ou CRITICAL (9.0+) -->
					<failBuildOnCVSS>7</failBuildOnCVSS>
					<!-- Formato do relatório: HTML para revisão manual, JSON para CI -->
					<formats>
						<format>HTML</format>
						<format>JSON</format>
					</formats>
					<!-- Exclui artefatos de escopo test — não vão para produção -->
					<skipTestScope>true</skipTestScope>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
